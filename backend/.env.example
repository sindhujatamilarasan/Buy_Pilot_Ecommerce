# Copy this file to .env and fill in your values. Never commit .env!
SECRET_KEY=change-me
DEBUG=True

# PostgreSQL (see README: one docker run command). Leave DB_NAME empty to fall back to SQLite.
DB_NAME=shopkart
DB_USER=shopkart
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5434

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Razorpay TEST keys (leave empty to use the mock payment screen)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
