# Copy this file to .env and fill in your values. Never commit .env!
SECRET_KEY=change-me
DEBUG=True

# Leave DB_NAME empty to use SQLite. Fill these in once PostgreSQL is installed:
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Razorpay TEST keys (leave empty to use the mock payment screen)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
